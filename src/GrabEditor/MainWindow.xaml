<Window x:Class="GrabEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GrabEditor.Controls"
        Title="Grab Editor" Icon="Assets/icon.ico"
        Width="1400" Height="860" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">

    <Window.Resources>
        <!-- round colour swatch used for text colours -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}" Stroke="#444444" StrokeThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="Shell" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="262"/>
            </Grid.RowDefinitions>

            <!-- ============================== top bar ============================== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Image Source="Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Grab Editor" FontSize="17" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <TextBlock x:Name="ProjectTitle" Text="Untitled" FontSize="13.5" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    <TextBlock x:Name="ToolWarn" Foreground="{StaticResource DangerBrush}" FontSize="12.5" VerticalAlignment="Center"
                               Margin="16,0,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnImport" Style="{StaticResource PillButton}" Height="36" Padding="14,0" Click="Import_Click"
                            ToolTip="Add videos to the project (Ctrl+I)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Import" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnOpen" Content="&#xE8E5;" Style="{StaticResource IconButton}" Margin="10,0,0,0" ToolTip="Open a project (Ctrl+O)" Click="Open_Click"/>
                    <Button x:Name="BtnSave" Content="&#xE74E;" Style="{StaticResource IconButton}" ToolTip="Save the project (Ctrl+S)" Click="Save_Click"/>
                    <Border Width="1" Height="20" Background="{StaticResource LineBrush}" Margin="8,0"/>
                    <Button x:Name="BtnUndo" Content="&#xE7A7;" Style="{StaticResource IconButton}" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click"/>
                    <Button x:Name="BtnRedo" Content="&#xE7A6;" Style="{StaticResource IconButton}" ToolTip="Redo (Ctrl+Y)" Click="Redo_Click"/>
                    <Button x:Name="BtnHelp" Content="&#xE897;" Style="{StaticResource IconButton}" Margin="0,0,10,0" ToolTip="Shortcuts (F1)" Click="Help_Click"/>
                    <Button x:Name="BtnExport" Content="Export" Style="{StaticResource PillPrimary}" Height="36" Padding="22,0" Click="Export_Click"
                            ToolTip="Render the video (Ctrl+E)"/>
                </StackPanel>
            </Grid>

            <!-- ============================== middle ============================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <!-- media library -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="16,14,16,8">
                            <TextBlock Text="MEDIA" Style="{StaticResource SectionLabel}" Margin="0"/>
                            <TextBlock x:Name="MediaCountText" Style="{StaticResource Muted}" FontSize="11.5" HorizontalAlignment="Right"/>
                        </Grid>
                        <ScrollViewer x:Name="MediaScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0,6,12">
                            <StackPanel>
                                <WrapPanel x:Name="MediaList"/>
                                <StackPanel x:Name="MediaEmpty" Margin="6,30,6,0" HorizontalAlignment="Center">
                                    <TextBlock Text="No videos yet" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Drop video files here, or use Import at the top."
                                               Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- preview -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="10,10,10,0" Background="#070707" CornerRadius="12" ClipToBounds="True">
                            <Grid x:Name="AspectHost" SizeChanged="AspectHost_SizeChanged">
                                <Border x:Name="PreviewFrame" Background="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        ClipToBounds="True" MouseLeftButtonUp="Preview_Click">
                                    <Grid>
                                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                                      ScrubbingEnabled="True" Stretch="Uniform"
                                                      MediaOpened="Player_MediaOpened" MediaFailed="Player_MediaFailed" MediaEnded="Player_MediaEnded"/>
                                        <Grid x:Name="TextLayer" IsHitTestVisible="False"/>
                                        <TextBlock x:Name="PreviewNote" Foreground="{StaticResource MutedBrush}" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap" Margin="20" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>

                                <!-- welcome screen while the project is empty -->
                                <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                    <Image Source="Assets/logo.png" Width="76" Height="76" HorizontalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="Let's make something" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                                    <TextBlock Text="Drop videos anywhere, or start with a button below."
                                               Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                        <Button Content="Import videos" Style="{StaticResource PillPrimary}" Padding="20,0" Click="ImportFiles_Click"/>
                                        <Button Content="Open project" Style="{StaticResource PillButton}" Margin="8,0,0,0" Padding="18,0" Click="Open_Click"/>
                                    </StackPanel>
                                    <Button Content="Download a video from a link" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                            HorizontalAlignment="Center" Click="ImportLink_Click"/>
                                    <StackPanel x:Name="RecentBox" Margin="0,18,0,0">
                                        <TextBlock Text="RECENT PROJECTS" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center"/>
                                        <StackPanel x:Name="RecentList" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- aspect ratio -->
                                <Border x:Name="AspectBar" Style="{StaticResource SegHost}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,10,10,0" Background="#CC1C1C1C">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="RbA169" GroupName="aspect" Content="16:9" Tag="16:9" IsChecked="True"
                                                     Style="{StaticResource SegButton}" FontSize="12" Click="Aspect_Click"/>
                                        <RadioButton x:Name="RbA916" GroupName="aspect" Content="9:16" Tag="9:16"
                                                     Style="{StaticResource SegButton}" FontSize="12" Click="Aspect_Click"/>
                                        <RadioButton x:Name="RbA11" GroupName="aspect" Content="1:1" Tag="1:1"
                                                     Style="{StaticResource SegButton}" FontSize="12" Click="Aspect_Click"/>
                                        <RadioButton x:Name="RbA45" GroupName="aspect" Content="4:5" Tag="4:5"
                                                     Style="{StaticResource SegButton}" FontSize="12" Click="Aspect_Click"/>
                                    </UniformGrid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="14,8,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TimeText" Text="0:00.0 / 0:00.0" FontSize="13" VerticalAlignment="Center"
                                       Typography.NumeralAlignment="Tabular"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnStart" Content="&#xE892;" Style="{StaticResource IconButton}" ToolTip="Go to the start (Home)" Click="GoStart_Click"/>
                                <Button x:Name="BtnPlay" Style="{StaticResource PlayButton}" Content="&#xE768;" Margin="6,0" ToolTip="Play / pause (Space)" Click="Play_Click"/>
                                <Button x:Name="BtnEnd" Content="&#xE893;" Style="{StaticResource IconButton}" ToolTip="Go to the end (End)" Click="GoEnd_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="PreviewHint" Grid.Column="2" Style="{StaticResource Muted}" FontSize="11.5" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Text="Preview is a fast low-quality copy. Exports are full quality."/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- inspector -->
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,14,16">
                        <Grid>
                            <!-- nothing selected -->
                            <StackPanel x:Name="InspectorEmpty">
                                <TextBlock Text="PROJECT" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="ProjectInfo" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"/>
                                <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="0,16"/>
                                <TextBlock Text="Click a clip or a text on the timeline to change it here." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                <TextBlock Text="TIPS" Style="{StaticResource SectionLabel}" Margin="0,22,0,8"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20"
                                           Text="Press S to split at the playhead.&#x0A;Drag a clip's edges to trim it.&#x0A;Drag a clip sideways to reorder.&#x0A;Press [ or ] to trim to the playhead.&#x0A;Hold Alt while dragging to turn snapping off.&#x0A;Press F1 for all shortcuts."/>
                            </StackPanel>

                            <!-- a clip is selected -->
                            <StackPanel x:Name="ClipPanel" Visibility="Collapsed">
                                <TextBlock Text="CLIP" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="ClipTitle" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ClipInfo" Style="{StaticResource Muted}" Margin="0,2,0,0"/>

                                <TextBlock Text="SPEED" Style="{StaticResource SectionLabel}" Margin="0,20,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="4" Value="1" SmallChange="0.05" LargeChange="0.25" TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" Style="{StaticResource GrabSlider}" VerticalAlignment="Center"
                                            PreviewMouseLeftButtonDown="Gesture_Start" ValueChanged="SpeedSlider_Changed"/>
                                    <TextBox x:Name="SpeedBox" Grid.Column="1" Width="70" Height="32" Margin="12,0,0,0" LostFocus="SpeedBox_Commit" KeyDown="NumberBox_KeyDown"/>
                                </Grid>

                                <TextBlock Text="VOLUME" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="VolSlider" Minimum="0" Maximum="200" Value="100" SmallChange="1" LargeChange="10" TickFrequency="1"
                                            IsSnapToTickEnabled="True" Style="{StaticResource GrabSlider}" VerticalAlignment="Center"
                                            PreviewMouseLeftButtonDown="Gesture_Start" ValueChanged="VolSlider_Changed"/>
                                    <TextBox x:Name="VolBox" Grid.Column="1" Width="70" Height="32" Margin="12,0,0,0" LostFocus="VolBox_Commit" KeyDown="NumberBox_KeyDown"/>
                                </Grid>

                                <TextBlock Text="FADE IN" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="FadeInSlider" Minimum="0" Maximum="3" Value="0" SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1"
                                            IsSnapToTickEnabled="True" Style="{StaticResource GrabSlider}" VerticalAlignment="Center"
                                            PreviewMouseLeftButtonDown="Gesture_Start" ValueChanged="FadeInSlider_Changed"/>
                                    <TextBox x:Name="FadeInBox" Grid.Column="1" Width="70" Height="32" Margin="12,0,0,0" LostFocus="FadeInBox_Commit" KeyDown="NumberBox_KeyDown"/>
                                </Grid>

                                <TextBlock Text="FADE OUT" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="FadeOutSlider" Minimum="0" Maximum="3" Value="0" SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1"
                                            IsSnapToTickEnabled="True" Style="{StaticResource GrabSlider}" VerticalAlignment="Center"
                                            PreviewMouseLeftButtonDown="Gesture_Start" ValueChanged="FadeOutSlider_Changed"/>
                                    <TextBox x:Name="FadeOutBox" Grid.Column="1" Width="70" Height="32" Margin="12,0,0,0" LostFocus="FadeOutBox_Commit" KeyDown="NumberBox_KeyDown"/>
                                </Grid>

                                <TextBlock Text="IN THE FRAME" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
                                <Border Style="{StaticResource SegHost}">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="RbFit" GroupName="fit" Content="Fit" IsChecked="True" Style="{StaticResource SegButton}" Click="Fit_Click"
                                                     ToolTip="Show the whole picture, with bars if the shapes differ"/>
                                        <RadioButton x:Name="RbFill" GroupName="fit" Content="Fill" Style="{StaticResource SegButton}" Click="Fit_Click"
                                                     ToolTip="Fill the frame, cropping the edges"/>
                                    </UniformGrid>
                                </Border>

                                <Grid Margin="0,22,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Content="Duplicate" Click="DupClip_Click" ToolTip="Copy this clip right after itself (Ctrl+D)"/>
                                    <Button Grid.Column="2" Content="Delete" Click="Delete_Click" ToolTip="Remove this clip (Delete)"/>
                                </Grid>
                            </StackPanel>

                            <!-- a text is selected -->
                            <StackPanel x:Name="TextPanel" Visibility="Collapsed">
                                <TextBlock Text="TEXT" Style="{StaticResource SectionLabel}"/>
                                <TextBox x:Name="TextEdit" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" MaxHeight="160" Padding="10,8"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                         GotKeyboardFocus="Gesture_Start2" TextChanged="TextEdit_Changed"/>

                                <TextBlock Text="SIZE" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="TextSizeSlider" Minimum="2" Maximum="20" Value="7" SmallChange="0.5" LargeChange="2" TickFrequency="0.5"
                                            IsSnapToTickEnabled="True" Style="{StaticResource GrabSlider}" VerticalAlignment="Center"
                                            PreviewMouseLeftButtonDown="Gesture_Start" ValueChanged="TextSize_Changed"/>
                                    <TextBox x:Name="TextSizeBox" Grid.Column="1" Width="70" Height="32" Margin="12,0,0,0" LostFocus="TextSizeBox_Commit" KeyDown="NumberBox_KeyDown"/>
                                </Grid>

                                <TextBlock Text="POSITION" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
                                <Border Style="{StaticResource SegHost}">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="RbPosTop" GroupName="pos" Content="Top" Tag="top" Style="{StaticResource SegButton}" Click="TextPos_Click"/>
                                        <RadioButton x:Name="RbPosMid" GroupName="pos" Content="Middle" Tag="center" Style="{StaticResource SegButton}" Click="TextPos_Click"/>
                                        <RadioButton x:Name="RbPosBottom" GroupName="pos" Content="Bottom" Tag="bottom" IsChecked="True" Style="{StaticResource SegButton}" Click="TextPos_Click"/>
                                    </UniformGrid>
                                </Border>

                                <TextBlock Text="COLOUR" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Sw1" GroupName="tcolor" Tag="#FFFFFF" Background="#FFFFFF" Style="{StaticResource Swatch}" Click="TextColor_Click"/>
                                    <RadioButton x:Name="Sw2" GroupName="tcolor" Tag="#FFE066" Background="#FFE066" Style="{StaticResource Swatch}" Click="TextColor_Click"/>
                                    <RadioButton x:Name="Sw3" GroupName="tcolor" Tag="#FF6B6B" Background="#FF6B6B" Style="{StaticResource Swatch}" Click="TextColor_Click"/>
                                    <RadioButton x:Name="Sw4" GroupName="tcolor" Tag="#6BCB77" Background="#6BCB77" Style="{StaticResource Swatch}" Click="TextColor_Click"/>
                                    <RadioButton x:Name="Sw5" GroupName="tcolor" Tag="#4D96FF" Background="#4D96FF" Style="{StaticResource Swatch}" Click="TextColor_Click"/>
                                    <RadioButton x:Name="Sw6" GroupName="tcolor" Tag="#111111" Background="#111111" Style="{StaticResource Swatch}" Click="TextColor_Click"/>
                                </StackPanel>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Dark box behind the text" FontWeight="SemiBold"/>
                                        <TextBlock Text="Easier to read on busy pictures" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="BoxSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="BoxSwitch_Click"/>
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="STARTS AT" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TextStartBox" Height="32" LostFocus="TextTime_Commit" KeyDown="NumberBox_KeyDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="LASTS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TextDurBox" Height="32" LostFocus="TextTime_Commit" KeyDown="NumberBox_KeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="Delete text" Margin="0,22,0,0" Click="Delete_Click"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ============================== timeline ============================== -->
            <Border Grid.Row="3" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="12,10,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnSplit" Style="{StaticResource SmallButton}" Click="Split_Click" ToolTip="Cut the clip at the playhead (S)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C6;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Split" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnDelete" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="Delete_Click" ToolTip="Delete the selection (Delete)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Delete" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddText" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="AddText_Click" ToolTip="Add a text at the playhead (T)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D2;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Text" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="TimelineInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Snap" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"
                                       ToolTip="Edges stick to each other and to the playhead. Hold Alt to ignore."/>
                            <CheckBox x:Name="SnapSwitch" Style="{StaticResource Switch}" IsChecked="True" Click="Snap_Click"/>
                            <Border Width="1" Height="20" Background="{StaticResource LineBrush}" Margin="14,0"/>
                            <Button Content="&#xE738;" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" ToolTip="Zoom out (-)" Click="ZoomOut_Click"/>
                            <Slider x:Name="ZoomSlider" Width="130" Minimum="2" Maximum="6.4" Value="4.4" SmallChange="0.1" LargeChange="0.5"
                                    Style="{StaticResource GrabSlider}" VerticalAlignment="Center" ValueChanged="Zoom_Changed"/>
                            <Button Content="&#xE710;" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" ToolTip="Zoom in (+)" Click="ZoomIn_Click"/>
                            <Button Content="Fit" Style="{StaticResource SmallButton}" Margin="8,0,0,0" ToolTip="Show everything" Click="ZoomFit_Click"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="TimelineScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Margin="8,0,8,8" PreviewMouseWheel="TimelineScroll_Wheel">
                        <c:TimelineView x:Name="Timeline" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- import menu -->
        <Popup x:Name="ImportPopup" PlacementTarget="{Binding ElementName=BtnImport}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" VerticalOffset="6">
            <Border Style="{StaticResource Card}" Background="#1C1C1C" Padding="6" CornerRadius="12" Margin="0,0,14,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel MinWidth="230">
                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="12,9" Click="ImportFiles_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" Width="22" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Video files…" Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="12,9" Click="ImportLink_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Width="22" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="From a link (download)…" Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- small message at the bottom -->
        <Border x:Name="ToastBorder" Background="#F0242424" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10"
                Padding="16,9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,296" Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" FontSize="13"/>
        </Border>

        <!-- ============================== export ============================== -->
        <Grid x:Name="ExportOverlay" Background="#CC000000" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="540" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource PanelBrush}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Export video" FontSize="18" FontWeight="Bold"/>
                        <Button x:Name="BtnExpClose" Content="&#xE711;" Style="{StaticResource IconButton}" Width="32" Height="32" HorizontalAlignment="Right" Click="ExpClose_Click"/>
                    </Grid>
                    <TextBlock x:Name="ExpSummary" Style="{StaticResource Muted}" Margin="0,4,0,0"/>

                    <TextBlock Text="SIZE" Style="{StaticResource SectionLabel}" Margin="0,22,0,8"/>
                    <Border Style="{StaticResource SegHost}">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="ExpR1080" GroupName="expsize" Content="1080p" Tag="1080" Style="{StaticResource SegButton}" Click="ExpOption_Click"/>
                            <RadioButton x:Name="ExpR720" GroupName="expsize" Content="720p" Tag="720" Style="{StaticResource SegButton}" Click="ExpOption_Click"/>
                            <RadioButton x:Name="ExpR480" GroupName="expsize" Content="480p" Tag="480" Style="{StaticResource SegButton}" Click="ExpOption_Click"/>
                            <RadioButton x:Name="ExpRDiscord" GroupName="expsize" Content="Under 25 MB" Tag="0" Style="{StaticResource SegButton}" Click="ExpOption_Click"
                                         ToolTip="Shrinks the video so the file fits in a Discord message"/>
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="QUALITY" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
                    <Border Style="{StaticResource SegHost}">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="ExpQFast" GroupName="expq" Content="Fast" Tag="fast" Style="{StaticResource SegButton}" Click="ExpOption_Click"
                                         ToolTip="Quickest, bigger file"/>
                            <RadioButton x:Name="ExpQBalanced" GroupName="expq" Content="Balanced" Tag="balanced" Style="{StaticResource SegButton}" Click="ExpOption_Click"/>
                            <RadioButton x:Name="ExpQHigh" GroupName="expq" Content="Best" Tag="high" Style="{StaticResource SegButton}" Click="ExpOption_Click"
                                         ToolTip="Slowest, best looking for its size"/>
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="SAVE TO" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ExpPath" Height="36" FontSize="12.5"/>
                        <Button x:Name="BtnExpBrowse" Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Style="{StaticResource SmallButton}" Height="36" Click="ExpBrowse_Click"/>
                    </Grid>

                    <TextBlock x:Name="ExpError" Foreground="{StaticResource DangerBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>

                    <Grid Margin="0,22,0,0">
                        <Button x:Name="BtnExpStart" Content="Export" Style="{StaticResource PrimaryButton}" Click="ExpStart_Click"/>

                        <Grid x:Name="ExpProgPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Height="56" CornerRadius="12" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ExpColA" Width="0.0001*"/>
                                        <ColumnDefinition x:Name="ExpColB" Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="11"/>
                                    <StackPanel Grid.ColumnSpan="2" Margin="14,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ExpProgText" Text="Starting…" FontWeight="Medium"/>
                                        <TextBlock x:Name="ExpProgInfo" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Button x:Name="BtnExpCancel" Grid.Column="1" Content="Cancel" Margin="10,0,0,0" Padding="18,0" Click="ExpCancel_Click"/>
                        </Grid>

                        <Border x:Name="ExpDonePanel" Style="{StaticResource Card}" Background="{StaticResource Panel2Brush}" Padding="14,12" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Saved" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ExpDoneFile" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="26,2,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Content="Show in folder" Click="ExpShow_Click"/>
                                    <Button Grid.Column="2" Content="Done" Click="ExpClose_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================== download ============================== -->
        <Grid x:Name="DownloadOverlay" Background="#CC000000" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="560" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource PanelBrush}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Download a video" FontSize="18" FontWeight="Bold"/>
                        <Button x:Name="BtnDlClose" Content="&#xE711;" Style="{StaticResource IconButton}" Width="32" Height="32" HorizontalAlignment="Right" Click="DlClose_Click"/>
                    </Grid>
                    <TextBlock Text="Paste a link (YouTube, X, Vimeo and hundreds more). The video is saved in your Grab Editor folder and added to this project."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="DlUrl" Height="38" FontSize="13.5" KeyDown="DlUrl_KeyDown"/>
                        <Button x:Name="BtnDlFetch" Grid.Column="1" Content="Look up" Margin="8,0,0,0" Style="{StaticResource PillButton}" Height="38" Padding="18,0" Click="DlFetch_Click"/>
                    </Grid>

                    <StackPanel x:Name="DlDetails" Visibility="Collapsed">
                        <TextBlock x:Name="DlTitle" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,18,0,0"/>
                        <TextBlock x:Name="DlMeta" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        <TextBlock Text="QUALITY" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
                        <WrapPanel x:Name="DlRes"/>
                    </StackPanel>

                    <TextBlock x:Name="DlError" Foreground="{StaticResource DangerBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="DlHint" Style="{StaticResource Muted}" Margin="0,12,0,0" Visibility="Collapsed"/>

                    <Grid Margin="0,20,0,0">
                        <Button x:Name="BtnDlStart" Content="Download and add to project" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="DlStart_Click"/>

                        <Grid x:Name="DlProgPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Height="56" CornerRadius="12" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="DlColA" Width="0.0001*"/>
                                        <ColumnDefinition x:Name="DlColB" Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="11"/>
                                    <StackPanel Grid.ColumnSpan="2" Margin="14,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="DlProgText" Text="Starting…" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="DlProgInfo" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Button x:Name="BtnDlCancel" Grid.Column="1" Content="Cancel" Margin="10,0,0,0" Padding="18,0" Click="DlCancel_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================== shortcuts ============================== -->
        <Grid x:Name="HelpOverlay" Background="#CC000000" Visibility="Collapsed" MouseLeftButtonDown="HelpBackdrop_Click">
            <Border Style="{StaticResource Card}" Width="560" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}" MouseLeftButtonDown="HelpCard_Click">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Shortcuts" FontSize="18" FontWeight="Bold"/>
                        <Button Content="&#xE711;" Style="{StaticResource IconButton}" Width="32" Height="32" HorizontalAlignment="Right" Click="HelpClose_Click"/>
                    </Grid>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Space" Margin="0,0,0,7"/><TextBlock Text="S  or  B" Margin="0,0,0,7"/><TextBlock Text="Delete" Margin="0,0,0,7"/>
                            <TextBlock Text="Ctrl + D" Margin="0,0,0,7"/><TextBlock Text="T" Margin="0,0,0,7"/><TextBlock Text="[   and   ]" Margin="0,0,0,7"/>
                            <TextBlock Text="←  →" Margin="0,0,0,7"/><TextBlock Text="Shift + ←  →" Margin="0,0,0,7"/><TextBlock Text="Home  /  End" Margin="0,0,0,7"/>
                            <TextBlock Text="+   and   -" Margin="0,0,0,7"/><TextBlock Text="Ctrl + Z   /   Ctrl + Y" Margin="0,0,0,7"/>
                            <TextBlock Text="Ctrl + I" Margin="0,0,0,7"/><TextBlock Text="Ctrl + S   /   Ctrl + O" Margin="0,0,0,7"/>
                            <TextBlock Text="Ctrl + E" Margin="0,0,0,7"/><TextBlock Text="Alt (while dragging)"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Play / pause" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,7"/>
                            <TextBlock Text="Split the clip at the playhead" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,7"/>
                            <TextBlock Text="Delete the selected clip or text" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,7"/>
                            <TextBlock Text="Duplicate the selected clip" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,7"/>
                            <TextBlock Text="Add a text at the playhead" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,7"/>
                            <TextBlock Text="Trim the clip's start / end to the playhead" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,7"/>
                            <TextBlock Text="One frame back / forward" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,7"/>
                            <TextBlock Text="One second back / forward" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,7"/>
                            <TextBlock Text="Jump to the start / end" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,7"/>
                            <TextBlock Text="Zoom the timeline in / out" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,7"/>
                            <TextBlock Text="Undo / redo" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,7"/>
                            <TextBlock Text="Import videos" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,7"/>
                            <TextBlock Text="Save / open a project" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,7"/>
                            <TextBlock Text="Export the video" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,7"/>
                            <TextBlock Text="Turn snapping off for that drag" Style="{StaticResource Muted}" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="0,18,0,14"/>
                    <Grid>
                        <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="GitHub" Style="{StaticResource SmallButton}" Click="GitHub_Click"/>
                            <Button Content="Clear preview cache" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="ClearCache_Click"
                                    ToolTip="Deletes the small preview copies. They are made again when needed."/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
